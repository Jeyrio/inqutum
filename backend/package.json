{
  "name": "inqutum-backend",
  "version": "1.0.0",
  "description": "Stellar-based invoice system backend. Two servers share the same InvoiceStorage contract, StoredInvoice shape, Zod schemas, route handlers and HTTP envelopes: server.ts (Postgres persistence) and server-mvp.ts (in-memory MVP). Field and behaviour parity between the two backends is pinned by the shared invoice-handlers.test.ts suite.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:pg": "tsx watch src/server.ts",
    "dev:mvp": "tsx watch src/server-mvp.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/isolated/*.test.js",
    "test:redaction": "node --import tsx --test tests/redaction.test.ts",
    "test:pg": "node --import tsx --test tests/invoice-postgres.integration.test.ts",
    "test:isolated": "node --test tests/isolated/*.test.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:pg": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "start:mvp": "tsx src/server-mvp.ts",
    "start:mvp:prod": "node dist/backend/src/server-mvp.js",
    "deploy:smoke": "node ../scripts/deploy-smoke.mjs",
    "evidence:smoke": "node scripts/evidence-smoke.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:validate": "tsx src/db/validate-restore.ts",
    "db:validate-snapshot": "tsx src/db/validate-snapshot-restore.ts",
    "journey:monitor": "tsx ../scripts/synthetic-journey-monitor.ts",
    "db:import": "tsx src/imports/import-cli.ts",
    "db:seed": "tsx src/db/seed.ts",
    "diagnostics": "tsx ../scripts/diagnostics.ts",
    "evidence:pack": "tsx ../scripts/generate-evidence-pack.ts",
    "evidence:check": "tsx ../scripts/generate-evidence-pack.ts --check",
    "release:gate": "tsx ../scripts/release-readiness-gate.ts",
    "release:check": "tsx ../scripts/release-readiness-gate.ts --check",
    "test:load:cardinality": "tsx ../scripts/load-cardinality-burst.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stellar",
    "crypto",
    "invoice",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^12.1.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "bull": "^4.12.2",
    "ioredis": "^5.3.2",
    "nanoid": "^3.3.7",
    "qrcode": "^1.5.3",
    "tsx": "^4.7.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.8",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.3.3"
  }
}
